<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>QUARRYConvexOAuthClientID</key>
	<string>$(CONVEX_OAUTH_CLIENT_ID)</string>
	<key>QUARRYConvexOAuthClientSecret</key>
	<string>$(CONVEX_OAUTH_CLIENT_SECRET)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>Preferred default scene session role</key>
	<string>MainWindow</string>
	<key>SEnableDownloaderService</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<!-- Pre-rebrand OAuth identifiers: must match the redirect registered with Convex. -->
			<key>CFBundleURLName</key>
			<string>com.pluk.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pluk</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Quarry Workspace Item</string>
			<key>UTTypeIdentifier</key>
			<string>se.ribban.quarry.workspace-item</string>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.database</string>
			</array>
			<key>UTTypeDescription</key>
			<string>SQLite Database</string>
			<key>UTTypeIdentifier</key>
			<string>se.ribban.quarry.sqlite-database</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>db</string>
					<string>sqlite</string>
					<string>sqlite3</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.sqlite3</string>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>db</string>
				<string>sqlite</string>
				<string>sqlite3</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>SQLite Database</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>se.ribban.quarry.sqlite-database</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
